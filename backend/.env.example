# Local dev default is sqlite; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./megafantasy.db

JWT_SECRET=change-me-to-a-long-random-string
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30

# The 6 league members allowed to log in. First one becomes commissioner when seeded.
ALLOWED_EMAILS=alice@example.com,bob@example.com,carol@example.com,dave@example.com,erin@example.com,frank@example.com

# Leave unset to log magic links to the console instead of emailing them.
RESEND_API_KEY=
EMAIL_FROM=Megafantasy <onboarding@resend.dev>

# Where the frontend and API are reachable, used for redirects, CORS, and email links.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Set to true once served over HTTPS in production.
COOKIE_SECURE=false
